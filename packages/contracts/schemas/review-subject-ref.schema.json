{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bullmatch.local/contracts/review-subject-ref/1.0.0",
  "title": "ReviewSubjectRef",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "type", "id", "secondary_refs"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "enum": ["CANDIDATE_GROUP", "CLAIM", "CANONICAL_ENTITY", "SOURCE", "AGENT_RUN"] },
    "type": {
      "enum": ["MATCH", "MATCH_PARTICIPANT", "BULL", "CAMP", "OWNER", "VENUE", "EVENT", "SOURCE", "AGENT_RUN", "OTHER"]
    },
    "id": { "type": "string", "format": "uuid" },
    "secondary_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "type", "id"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
