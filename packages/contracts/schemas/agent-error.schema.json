{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bullmatch.local/contracts/agent-error/1.0.0",
  "title": "AgentError",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "stage", "retryable", "occurred_at", "details"],
  "properties": {
    "code": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "stage": {
      "enum": ["SOURCE_DISCOVERY", "SOURCE_MONITORING", "INGESTION", "EXTRACTION", "ENTITY_RESOLUTION", "DUPLICATE_DETECTION", "VERIFICATION", "DATA_QUALITY", "REPORT", "PERSISTENCE", "UNKNOWN"]
    },
    "retryable": { "type": "boolean" },
    "source_id": { "type": ["string", "null"], "format": "uuid" },
    "source_item_id": { "type": ["string", "null"], "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "details": { "type": "object", "additionalProperties": true }
  }
}
